{
  "name": "mom-lens",
  "version": "0.1.0",
  "description": "mom-lens — a Lens-style Kubernetes IDE (Electron + React + @kubernetes/client-node)",
  "main": "out/main/index.js",
  "author": "sothana",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:k8s": "tsx scripts/smoke.ts",
    "test:ai": "tsx scripts/ai-smoke.ts",
    "package": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@kubernetes/client-node": "^0.22.3",
    "@uiw/react-codemirror": "^4.23.6",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
